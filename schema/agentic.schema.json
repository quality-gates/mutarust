{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mutarust agent-ready escaped-mutant report",
  "description": "Agent-ready report written to mutarust-agentic.json when --logger-agentic-json is enabled.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "generated_at",
    "msi",
    "escaped_count",
    "reminder",
    "mutants"
  ],
  "properties": {
    "generated_at": {
      "type": "string",
      "minLength": 1,
      "description": "RFC 3339 generation time"
    },
    "msi": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Mutation score from zero to one"
    },
    "escaped_count": {
      "type": "integer",
      "minimum": 0
    },
    "reminder": {
      "type": "string",
      "minLength": 1
    },
    "mutants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "file",
          "line",
          "mutator",
          "description",
          "kill_hint",
          "diff",
          "context_start_line",
          "context_lines",
          "test_files"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "file": { "type": "string", "minLength": 1 },
          "line": { "type": "integer", "minimum": 1 },
          "mutator": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "kill_hint": { "type": "string" },
          "diff": { "type": "string" },
          "context_start_line": { "type": "integer", "minimum": 0 },
          "context_lines": {
            "type": "array",
            "items": { "type": "string" }
          },
          "test_files": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
